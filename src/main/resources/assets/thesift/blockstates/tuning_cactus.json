{
  "multipart": [
    {
      "apply": {
        "model": "thesift:block/tuning_cactus_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_down"
      }
    }
  ]
}
