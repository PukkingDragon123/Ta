{
  "multipart": [
    {
      "when": {
        "age": "0|1|2|3|4"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_bud"
      }
    },
    {
      "when": {
        "age": "5",
        "fruit": "false"
      },
      "apply": [
        {
          "model": "thesift:block/tuning_cactus_crown"
        },
        {
          "model": "thesift:block/tuning_cactus_crown",
          "y": 90
        }
      ]
    },
    {
      "when": {
        "age": "5",
        "fruit": "true"
      },
      "apply": [
        {
          "model": "thesift:block/tuning_cactus_crown_fruit"
        },
        {
          "model": "thesift:block/tuning_cactus_crown_fruit",
          "y": 90
        }
      ]
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_side",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "thesift:block/tuning_cactus_down"
      }
    }
  ]
}
