{
  "multipart": [
    {
      "apply": {
        "model": "thesift:block/sky_vine_core"
      }
    },
    {
      "apply": {
        "model": "thesift:block/sky_vine_arm"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "thesift:block/sky_vine_arm",
        "y": 90,
        "uvlock": true
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "thesift:block/sky_vine_arm",
        "y": 180,
        "uvlock": true
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "thesift:block/sky_vine_arm",
        "y": 270,
        "uvlock": true
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "thesift:block/sky_vine_arm",
        "x": 270,
        "uvlock": true
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "thesift:block/sky_vine_arm",
        "x": 90,
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    }
  ]
}
