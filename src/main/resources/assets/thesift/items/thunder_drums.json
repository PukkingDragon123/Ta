{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed",
          "on_shelf",
          "head"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "thesift:item/thunder_drums"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "thesift:instrument_play",
        "entries": [
          {
            "threshold": 1.0,
            "model": {
              "type": "minecraft:model",
              "model": "thesift:item/thunder_drums_play_l"
            }
          },
          {
            "threshold": 2.0,
            "model": {
              "type": "minecraft:model",
              "model": "thesift:item/thunder_drums_play_r"
            }
          },
          {
            "threshold": 3.0,
            "model": {
              "type": "minecraft:model",
              "model": "thesift:item/thunder_drums_play_up"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "thesift:item/thunder_drums_play"
        }
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "thesift:item/thunder_drums"
      }
    }
  }
}
